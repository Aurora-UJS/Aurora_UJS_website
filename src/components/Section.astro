---
import { asset } from "../lib/utils";

/**
 * Section wrapper — replaces the old Jekyll `section.html` + comment-splitting.
 * `dark` paints a night-sky band; `background` sets a cover image (with overlay).
 */
interface Props {
  id?: string;
  dark?: boolean;
  background?: string; // public path e.g. "/images/background.jpg"
  size?: "narrow" | "default" | "wide" | "full";
  class?: string;
  innerClass?: string;
}
const {
  id,
  dark = false,
  background,
  size = "default",
  class: className = "",
  innerClass = "",
} = Astro.props;

const widths: Record<string, string> = {
  narrow: "max-w-3xl",
  default: "max-w-6xl",
  wide: "max-w-7xl",
  full: "max-w-none",
};

const bgUrl = background ? asset(background) : undefined;
const sectionClass = [
  "relative",
  dark || background ? "text-white" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<section id={id} class={sectionClass} data-dark={dark || !!background}>
  {
    background && (
      <>
        <div
          class="absolute inset-0 -z-10 bg-cover bg-center"
          style={`background-image:url('${bgUrl}')`}
        />
        <div class="absolute inset-0 -z-10 bg-night-950/75" />
      </>
    )
  }
  {
    dark && !background && (
      <div class="absolute inset-0 -z-10 bg-night-900" />
    )
  }
  <div
    class={`mx-auto w-full ${widths[size]} px-5 py-16 sm:px-8 sm:py-20 ${innerClass}`}
  >
    <slot />
  </div>
</section>
