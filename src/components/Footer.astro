---
import { site, nav } from "../data/site";
import { link, asset } from "../lib/utils";
import Icon from "./Icon.astro";

const socials = [
  { name: "github", href: site.links.github, label: "GitHub" },
  { name: "bilibili", href: site.links.bilibili, label: "Bilibili" },
  { name: "wechat", href: site.links.wechat, label: "微信公众号" },
  { name: "mail", href: `mailto:${site.links.email}`, label: "邮箱" },
];
const year = new Date().getFullYear();
---

<footer
  class="relative mt-auto overflow-hidden border-t border-slate-200/70 bg-slate-50 dark:border-white/10 dark:bg-night-900"
>
  <div
    class="pointer-events-none absolute -top-24 left-1/2 h-48 w-[36rem] -translate-x-1/2 rounded-full bg-gradient-to-r from-aurora-violet/20 via-aurora-cyan/20 to-aurora-emerald/20 blur-3xl"
  >
  </div>

  <div class="container-page relative py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <!-- brand + slogan -->
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <img
            src={asset("/images/logo.png")}
            alt=""
            width="40"
            height="40"
            class="size-10 rounded-md object-contain"
          />
          <span class="font-display text-lg font-bold text-slate-900 dark:text-white"
            >Aurora <span class="aurora-text">战队</span></span
          >
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          {site.org}创新团队 · 以参加 RoboMaster 机甲大师赛为主的综合型机器人战队。
        </p>
        <p class="mt-3 font-display text-sm font-semibold text-brand-600 dark:text-brand-400">
          「{site.slogan}」
        </p>
      </div>

      <!-- nav + data station -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            导航
          </h3>
          <ul class="mt-3 space-y-2 text-sm">
            {
              nav.slice(0, 4).map((item) => (
                <li>
                  <a
                    href={link(item.href)}
                    class="text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            更多
          </h3>
          <ul class="mt-3 space-y-2 text-sm">
            {
              nav.slice(4).map((item) => (
                <li>
                  <a
                    href={link(item.href)}
                    class="text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href={link("/sponsor")}
                class="text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
              >
                赞助我们
              </a>
            </li>
            <li>
              <a
                href={link("/25")}
                class="text-slate-600 hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
              >
                对手视频
              </a>
            </li>
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            关注我们
          </h3>
          <div class="mt-3 flex gap-2">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target={s.href.startsWith("mailto:") ? undefined : "_blank"}
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  title={s.label}
                  class="inline-flex size-10 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition hover:border-brand-400 hover:text-brand-600 dark:border-white/10 dark:text-slate-400 dark:hover:border-brand-500/50 dark:hover:text-brand-400"
                >
                  <Icon name={s.name} class="size-5" />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- partner logos + copyright -->
    <div
      class="mt-10 flex flex-col items-center gap-6 border-t border-slate-200/70 pt-6 dark:border-white/10 sm:flex-row sm:justify-between"
    >
      <div class="flex items-center gap-5 opacity-80 dark:opacity-70">
        <img
          src={asset("/images/school.png")}
          alt="江苏大学"
          height="36"
          class="h-9 w-auto object-contain dark:brightness-0 dark:invert"
        />
        <img
          src={asset("/images/aiim.png")}
          alt="人工智能与智能制造学院"
          height="36"
          class="h-9 w-auto object-contain dark:brightness-0 dark:invert"
        />
      </div>
      <p class="text-center text-xs text-slate-500 dark:text-slate-400 sm:text-right">
        © {year} Aurora 战队 · {site.school}<br class="sm:hidden" />
        <span class="px-1">·</span> Built with Astro
      </p>
    </div>
  </div>
</footer>
