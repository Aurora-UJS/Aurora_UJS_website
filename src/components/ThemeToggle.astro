---
import Icon from "./Icon.astro";
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  class={`relative inline-flex size-9 items-center justify-center rounded-full text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white ${className}`}
  aria-label="切换深色 / 浅色模式"
  title="切换深色 / 浅色模式"
>
  <Icon name="sun" class="size-5 dark:hidden" />
  <Icon name="moon" class="hidden size-5 dark:block" />
</button>

<script is:inline>
  // The no-FOUC init runs in <head> (see Head.astro). This just wires the click.
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle("dark");
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {}
    });
  })();
</script>
