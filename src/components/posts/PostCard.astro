---
import { asset, link } from "@/lib/utils";
import Icon from "@/components/Icon.astro";
import type { CollectionEntry } from "astro:content";

/** A single blog/news card. `base` is the collection route prefix. */
interface Props {
  entry: CollectionEntry<"posts"> | CollectionEntry<"news">;
  base: "/blog" | "/news";
}
const { entry, base } = Astro.props;
const { title, date, author, description, image, tags = [] } = entry.data;

/** Date-only "2025年6月1日" (UTC so it stays deterministic across build hosts). */
function postDate(d?: Date | null): string {
  if (!(d instanceof Date) || isNaN(+d)) return "";
  return `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
}

const isNews = base === "/news";
const icon = isNews ? "newspaper" : "feather";
const kind = isNews ? "动态" : "技术";
const href = link(`${base}/${entry.id}`);
const dateStr = postDate(date);
const primaryTag = tags[0] ?? title;

// Fall back to a trimmed body excerpt when no description is provided.
const excerpt =
  description ??
  (entry.body
    ? entry.body
        .replace(/[#>*`_~\[\]()!-]/g, "")
        .replace(/\s+/g, " ")
        .trim()
        .slice(0, 90)
    : "");
---

<a
  href={href}
  class="card group flex h-full flex-col overflow-hidden"
  aria-label={title}
>
  <!-- cover -->
  <div class="relative aspect-[16/9] overflow-hidden">
    {
      image ? (
        <img
          src={asset(image)}
          alt=""
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="relative flex size-full items-center justify-center bg-gradient-to-br from-brand-500/15 via-aurora-violet/15 to-aurora-cyan/15 dark:from-brand-500/20 dark:via-aurora-violet/20 dark:to-aurora-cyan/20">
          <div class="pointer-events-none absolute -right-6 -top-8 h-28 w-28 rounded-full bg-gradient-to-br from-brand-500/30 to-aurora-violet/30 blur-2xl" />
          <Icon name={icon} class="size-12 text-brand-600/70 dark:text-brand-400/70" />
          <span class="absolute bottom-3 left-4 max-w-[80%] truncate font-display text-sm font-semibold text-slate-700/80 dark:text-white/70">
            #{primaryTag}
          </span>
        </div>
      )
    }
    <span
      class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/85 px-2.5 py-1 text-xs font-semibold text-brand-700 shadow-sm backdrop-blur dark:bg-night-900/80 dark:text-brand-300"
    >
      <Icon name={icon} class="size-3.5" />
      {kind}
    </span>
  </div>

  <!-- body -->
  <div class="flex flex-1 flex-col p-5">
    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500 dark:text-slate-400"
    >
      {
        dateStr && (
          <span class="inline-flex items-center gap-1">
            <Icon name="calendar" class="size-3.5" />
            {dateStr}
          </span>
        )
      }
      {
        author && (
          <span class="inline-flex items-center gap-1">
            <Icon name="user" class="size-3.5" />
            {author}
          </span>
        )
      }
    </div>

    <h3
      class="mt-2 text-lg font-bold leading-snug text-slate-900 transition group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400"
    >
      {title}
    </h3>

    {
      excerpt && (
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {excerpt}
        </p>
      )
    }

    <div class="mt-auto pt-4">
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.slice(0, 3).map((t) => (
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-white/5 dark:text-slate-300">
                #{t}
              </span>
            ))}
          </div>
        )
      }
      <span
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-all group-hover:gap-2 dark:text-brand-400"
      >
        阅读全文
        <Icon name="arrow-right" class="size-4" />
      </span>
    </div>
  </div>
</a>
