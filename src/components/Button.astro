---
import Icon from "./Icon.astro";
import { link, isExternal } from "../lib/utils";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline" | "ghost" | "bare";
  icon?: string;
  iconPosition?: "left" | "right";
  size?: "sm" | "md" | "lg";
  class?: string;
  newTab?: boolean;
  title?: string;
}
const {
  href,
  variant = "primary",
  icon,
  iconPosition = "left",
  size = "md",
  class: className = "",
  newTab,
  title,
} = Astro.props;

const external = isExternal(href);
const target = newTab ?? external ? "_blank" : undefined;
const rel = target === "_blank" ? "noopener noreferrer" : undefined;

const base =
  "inline-flex items-center gap-2 font-medium rounded-full transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-night-950";

const sizes: Record<string, string> = {
  sm: "px-3.5 py-1.5 text-sm",
  md: "px-5 py-2.5 text-sm",
  lg: "px-6 py-3 text-base",
};

const variants: Record<string, string> = {
  primary:
    "bg-brand-600 text-white shadow-sm hover:bg-brand-700 hover:shadow-glow active:scale-[.98]",
  secondary:
    "bg-slate-900 text-white hover:bg-slate-700 dark:bg-white dark:text-night-950 dark:hover:bg-slate-200 active:scale-[.98]",
  outline:
    "border border-slate-300 text-slate-700 hover:border-brand-400 hover:text-brand-600 dark:border-white/15 dark:text-slate-200 dark:hover:border-brand-500/50 dark:hover:text-white",
  ghost:
    "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white",
  bare: "!px-0 !py-0 text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 hover:gap-3",
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const resolved = link(href);
---

<a href={resolved} class={cls} target={target} rel={rel} title={title}>
  {icon && iconPosition === "left" && <Icon name={icon} class="size-[1.1em]" />}
  <slot />
  {icon && iconPosition === "right" && <Icon name={icon} class="size-[1.1em]" />}
  {external && !icon && <Icon name="arrow-up-right" class="size-[1em] opacity-60" />}
</a>
