const segMeta: Record<string, { badge: string; icon: string }> = {
  联盟赛: { badge: "bg-azure-500/10 text-azure-600 dark:text-azure-400", icon: "bg-azure-500/10 text-azure-600 dark:text-azure-400" },
  分区赛: { badge: "bg-aurora-violet/10 text-aurora-violet dark:bg-aurora-violet/15 dark:text-violet-300", icon: "bg-aurora-violet/10 text-aurora-violet dark:bg-aurora-violet/15 dark:text-violet-300" },
  全国赛: { badge: "bg-brand-600/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400", icon: "bg-brand-600/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400" },
};

const totalVideos = schools.reduce(
  (n, s) => n + s.segments.reduce((m, seg) => m + seg.videos.length, 0),
  0,
);
const countOf = (s: School) =>
  s.segments.reduce((m, seg) => m + seg.videos.length, 0);
---

<BaseLayout
  title="25 赛季对手对局视频整合"
  description="25 赛季 RoboMaster 对手对局视频整合 —— 按学校战队与赛段（联盟赛 / 分区赛 / 全国赛）分类的 Bilibili 对局录像合集。"
>
  <PageHero
    icon="play-circle"
    eyebrow="对手情报 · 25 赛季"
    title="25 赛季对手对局视频整合"
    subtitle="按学校战队与赛段分类的对局录像合集，共收录"
  >
    <p class="mt-1 text-lg text-slate-600 dark:text-slate-400">
      <span class="font-display text-2xl font-bold text-brand-600 dark:text-brand-400"
        >{totalVideos}</span
      >
      场对局 · {schools.length} 支战队 · 联盟赛 / 分区赛 / 全国赛
    </p>
    <!-- 快速跳转 -->
    <div class="mt-6 flex flex-wrap gap-2.5">
      {
        schools.map((s, i) => (
          <a
            href={`#school-${i}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white/60 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition hover:border-brand-400 hover:text-brand-600 dark:border-white/10 dark:bg-white/5 dark:text-slate-300 dark:hover:border-brand-500/50 dark:hover:text-brand-400"
          >
            {s.school}
            <span class="text-xs text-slate-400">{countOf(s)}</span>
          </a>
        ))
      }
    </div>
  </PageHero>

  {
    schools.map((s, i) => (
      <Section id={`school-${i}`} class={i % 2 === 1 ? "bg-slate-50 dark:bg-night-900" : ""}>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="flex items-center gap-3 text-2xl font-bold sm:text-3xl">
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-600/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
                <Icon name="swords" class="size-5" />
              </span>
              {s.school}
            </h2>
            <p class="mt-2 pl-[3.25rem] text-sm font-medium text-slate-500 dark:text-slate-400">
              {s.team}
            </p>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-500 dark:bg-white/5 dark:text-slate-400">
            共 {countOf(s)} 场
          </span>
        </div>

        <div class="mt-8 space-y-10">
          {s.segments
            .filter((seg) => seg.videos.length > 0)
            .map((seg) => (
              <div>
                <h3 class="flex items-center gap-2.5 text-lg font-semibold">
                  <span class={`inline-flex items-center rounded-md px-2.5 py-1 text-sm font-semibold ${segMeta[seg.label].badge}`}>
                    {seg.label}
                  </span>
                  <span class="text-sm font-normal text-slate-400">
                    {seg.videos.length} 场
                  </span>
                </h3>

                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                  {seg.videos.map((v) => (
                    <li>
                      <a
                        href={bv(v.id)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="card group flex h-full items-start gap-3 p-4"
                      >
                        <span class={`mt-0.5 inline-flex size-9 shrink-0 items-center justify-center rounded-lg ${segMeta[seg.label].icon}`}>
                          <Icon name="play-circle" class="size-5" />
                        </span>
                        <span class="flex-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                          {v.title}
                        </span>
                        <Icon
                          name="external-link"
                          class="mt-0.5 size-4 shrink-0 text-slate-300 transition group-hover:text-brand-500 dark:text-slate-600"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
        </div>
      </Section>
    ))
  }
</BaseLayout>
