const bv = (id: string) => `https://www.bilibili.com/video/${id}/${Q}`;

type Video = { title: string; id: string };
type Segment = { label: "联盟赛" | "分区赛" | "全国赛"; videos: Video[] };
type School = { school: string; team: string; segments: Segment[] };

