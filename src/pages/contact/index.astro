---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";

const socials = [
  { name: "github", href: site.links.github, label: "GitHub" },
  { name: "bilibili", href: site.links.bilibili, label: "哔哩哔哩" },
  { name: "wechat", href: site.links.wechat, label: "微信公众号" },
];
---

<BaseLayout
  title="联系我们"
  description="Aurora 战队欢迎所有热爱机器人的同学加入 —— 邮箱、微信、实验室地址与招新信息。"
>
  <PageHero
    icon="mail"
    eyebrow="联系方式"
    title="联系我们"
    subtitle="欢迎所有热爱机器人的同学加入！"
  />

  <!-- 联系方式卡片 -->
  <Section>
    <div class="grid gap-6 md:grid-cols-3">
      <!-- 邮箱 -->
      <div class="card flex flex-col p-7">
        <span
          class="inline-flex size-12 items-center justify-center rounded-xl bg-brand-600/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400"
        >
          <Icon name="mail" class="size-6" />
        </span>
        <h2 class="mt-5 text-lg font-semibold">邮箱</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          日常事务、招新咨询，欢迎来信。
        </p>
        <p
          class="mt-4 select-all break-all font-mono text-sm text-slate-800 dark:text-slate-200"
        >
          {site.contact.email}
        </p>
        <div class="mt-5 pt-1">
          <Button
            href={`mailto:${site.contact.email}`}
            icon="mail"
            size="sm"
            variant="outline">发送邮件</Button
          >
        </div>
      </div>

      <!-- 微信 -->
      <div class="card flex flex-col p-7">
        <span
          class="inline-flex size-12 items-center justify-center rounded-xl bg-aurora-emerald/10 text-aurora-emerald"
        >
          <Icon name="wechat" class="size-6" />
        </span>
        <h2 class="mt-5 text-lg font-semibold">微信</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          企业赞助或合作事务洽谈，请添加微信。
        </p>
        <p class="mt-4 flex items-center gap-2">
          <span
            class="select-all rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 font-mono text-sm font-semibold text-slate-800 dark:border-white/10 dark:bg-white/5 dark:text-slate-100"
          >
            {site.contact.wechat}
          </span>
        </p>
        <p class="mt-auto pt-5 text-xs text-slate-400 dark:text-slate-500">
          赞助 / 合作洽谈专用
        </p>
      </div>

      <!-- 地址 -->
      <div class="card flex flex-col p-7">
        <span
          class="inline-flex size-12 items-center justify-center rounded-xl bg-azure-500/10 text-azure-600 dark:text-azure-400"
        >
          <Icon name="map-pin" class="size-6" />
        </span>
        <h2 class="mt-5 text-lg font-semibold">地址</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {site.contact.address}
        </p>
        <div class="mt-auto pt-5">
          <Button href={site.contact.map} icon="map-pin" size="sm" variant="outline"
            >在地图中查看</Button
          >
        </div>
      </div>
    </div>
  </Section>

  <!-- 加入我们 / 招新 CTA -->
  <Section background="/images/cheer.jpg" innerClass="max-w-3xl text-center">
    <p
      class="text-sm font-semibold uppercase tracking-widest text-brand-300"
    >
      Join Us · 招新进行中
    </p>
    <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">加入我们</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-slate-200">
      不限专业、不论基础，只要你对机器人、自动化与团队竞技充满热情，
      Aurora 战队都为你敞开大门。在这里与志同道合的伙伴一起，从零打造属于自己的战车。
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={`mailto:${site.contact.email}`} icon="mail" variant="primary"
        >邮件咨询招新</Button
      >
      <Button href={site.links.wechat} icon="wechat" variant="secondary"
        >关注微信公众号</Button
      >
    </div>
    <p class="mt-6 font-display text-sm font-semibold text-brand-300">
      「{site.slogan}」
    </p>
  </Section>

  <!-- 关注我们 -->
  <Section innerClass="text-center">
    <h2 class="text-2xl font-bold">关注我们</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      在以下平台获取战队的最新动态与技术分享。
    </p>
    <div class="mt-7 flex items-center justify-center gap-3">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            title={s.label}
            class="inline-flex size-12 items-center justify-center rounded-full border border-slate-200 text-slate-500 transition hover:-translate-y-0.5 hover:border-brand-400 hover:text-brand-600 dark:border-white/10 dark:text-slate-400 dark:hover:border-brand-500/50 dark:hover:text-brand-400"
          >
            <Icon name={s.name} class="size-5" />
          </a>
        ))
      }
    </div>
  </Section>
</BaseLayout>
