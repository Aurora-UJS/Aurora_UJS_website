---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import PostCard from "@/components/posts/PostCard.astro";

const news = (await getCollection("news"))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );

const allTags = [...new Set(news.flatMap((p) => p.data.tags))];

const PILL_BASE =
  "rounded-full border px-4 py-1.5 text-sm font-medium transition";
const PILL_ACTIVE = `${PILL_BASE} border-brand-600 bg-brand-600 text-white shadow-sm`;
const PILL_IDLE = `${PILL_BASE} border-slate-200 text-slate-600 hover:border-brand-300 hover:text-brand-600 dark:border-white/10 dark:text-slate-300 dark:hover:border-brand-500/50 dark:hover:text-brand-400`;
---

<BaseLayout title="战队动态" description="Aurora 战队的赛事喜报、招新公告与最新动态。">
  <PageHero
    icon="newspaper"
    eyebrow="战队动态"
    title="战队动态"
    subtitle="赛事喜报、招新公告与战队的每一步成长"
  >
    <p class="mt-5 inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
      <Icon name="sparkles" class="size-4 text-brand-600 dark:text-brand-400" />
      共 {news.length} 条动态
    </p>
  </PageHero>

  <Section>
    {
      news.length === 0 ? (
        <div class="mx-auto max-w-md rounded-2xl border border-dashed border-slate-300 px-6 py-16 text-center dark:border-white/15">
          <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-brand-600/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
            <Icon name="newspaper" class="size-7" />
          </span>
          <h2 class="mt-5 text-xl font-bold">暂无最新动态</h2>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
            战队的精彩故事正在书写，敬请期待。
          </p>
          <div class="mt-6 flex justify-center">
            <Button href="/blog" variant="outline" icon="feather">
              逛逛技术博客
            </Button>
          </div>
        </div>
      ) : (
        <>
          {allTags.length > 0 && (
            <div
              class="mb-10 flex flex-wrap items-center gap-2"
              data-tag-filter
            >
              <button type="button" data-tag="all" class={PILL_ACTIVE} aria-pressed="true">
                全部
              </button>
              {allTags.map((t) => (
                <button type="button" data-tag={t} class={PILL_IDLE} aria-pressed="false">
                  #{t}
                </button>
              ))}
            </div>
          )}

          <div
            class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
            data-post-grid
          >
            {news.map((p) => (
              <div data-tags={p.data.tags.join("|")}>
                <PostCard entry={p} base="/news" />
              </div>
            ))}
          </div>

          <p
            class="mt-10 hidden text-center text-sm text-slate-500 dark:text-slate-400"
            data-empty-filter
          >
            该标签下暂无动态。
          </p>
        </>
      )
    }
  </Section>

  <script is:inline>
  function initTagFilter() {
    const root = document.querySelector("[data-tag-filter]");
    const grid = document.querySelector("[data-post-grid]");
    if (!root || !grid) return;
    const buttons = Array.from(root.querySelectorAll("button[data-tag]"));
    const cards = Array.from(grid.querySelectorAll("[data-tags]"));
    const emptyMsg = document.querySelector("[data-empty-filter]");
    // active/idle class strings captured from the server-rendered buttons
    const activeBtn = root.querySelector('button[aria-pressed="true"]') || buttons[0];
    const ACTIVE = activeBtn ? activeBtn.className : "";
    const idleBtn = buttons.find((b) => b !== activeBtn);
    const IDLE = idleBtn ? idleBtn.className : ACTIVE;

    function apply(tag) {
      let visible = 0;
      for (const card of cards) {
        const tags = (card.getAttribute("data-tags") || "").split("|");
        const show = tag === "all" || tags.includes(tag);
        card.classList.toggle("hidden", !show);
        if (show) visible++;
      }
      if (emptyMsg) emptyMsg.classList.toggle("hidden", visible !== 0);
    }

    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        for (const b of buttons) {
          const isActive = b === btn;
          b.className = isActive ? ACTIVE : IDLE;
          b.setAttribute("aria-pressed", isActive ? "true" : "false");
        }
        apply(btn.getAttribute("data-tag") || "all");
      });
    }
  }

  initTagFilter();
  document.addEventListener("astro:after-swap", initTagFilter);
  </script>
</BaseLayout>
