---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import { link } from "@/lib/utils";

export async function getStaticPaths() {
  const news = await getCollection("news");
  return news
    .filter((p) => !p.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, author, description, image, tags = [] } = entry.data;

const base = "/news";
const backLabel = "战队动态";
const eyebrow = "NEWS";
const icon = "newspaper";

/** Date-only "2025年6月1日" (UTC for deterministic output). */
function postDate(d?: Date | null): string {
  if (!(d instanceof Date) || isNaN(+d)) return "";
  return `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
}
const dateStr = postDate(date);
---

<BaseLayout title={title} description={description} image={image} article={true}>
  <header
    class="relative overflow-hidden border-b border-slate-200/70 bg-slate-50 dark:border-white/10 dark:bg-night-900"
  >
    <div
      class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-gradient-to-br from-brand-500/20 to-aurora-violet/20 blur-3xl"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-gradient-to-tr from-aurora-cyan/20 to-aurora-emerald/20 blur-3xl"
    >
    </div>

    <div class="container-page relative py-14 sm:py-16">
      <a
        href={link(base)}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-brand-600 dark:text-slate-400 dark:hover:text-brand-400"
      >
        <Icon name="arrow-left" class="size-4" /> 返回{backLabel}
      </a>

      <p
        class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-brand-600/10 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-600 dark:bg-brand-500/15 dark:text-brand-400"
      >
        <Icon name={icon} class="size-3.5" />
        {eyebrow}
      </p>

      <h1 class="mt-4 max-w-3xl text-3xl font-bold sm:text-4xl">{title}</h1>

      {
        description && (
          <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
            {description}
          </p>
        )
      }

      <div
        class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500 dark:text-slate-400"
      >
        {
          dateStr && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="calendar" class="size-4" />
              {dateStr}
            </span>
          )
        }
        {
          author && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="user" class="size-4" />
              {author}
            </span>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 dark:border-white/10 dark:text-slate-300">
                #{t}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <Section size="narrow">
    {
      image && (
        <img
          src={link(image)}
          alt=""
          class="mb-10 aspect-[2/1] w-full rounded-2xl object-cover shadow-sm"
        />
      )
    }

    <article class="prose-aurora">
      <Content />
    </article>

    <div
      class="mt-12 flex items-center justify-between border-t border-slate-200/70 pt-8 dark:border-white/10"
    >
      <Button href={base} variant="outline" icon="arrow-left">
        返回{backLabel}
      </Button>
    </div>
  </Section>
</BaseLayout>
