---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import AwardCard from "@/components/awards/AwardCard.astro";
import Icon from "@/components/Icon.astro";
import { groupByYear, medalTier } from "@/lib/utils";

const awards = await getCollection("awards");
const members = await getCollection("members");
const memberIds = new Set(members.map((m) => m.id));

const total = awards.length;

const byType = (t: string) =>
  awards.filter((a) => (a.data.type ?? "").trim() === t).length;
const national = byType("国家级");
const intl = byType("国际级");
const provincial = byType("省级");
const other = byType("其他");

const tierCount = (t: string) =>
  awards.filter((a) => medalTier(a.data.prize) === t).length;
const gold = tierCount("gold");
const silver = tierCount("silver");
const bronze = tierCount("bronze");

const sorted = [...awards].sort((a, b) => {
  const da = a.data.date ? +a.data.date : 0;
  const db = b.data.date ? +b.data.date : 0;
  return db - da;
});
const grouped = groupByYear(sorted, (a) => a.data.date ?? null);

const stats = [
  { label: "累计奖项", value: total, icon: "trophy", accent: "text-brand-600 dark:text-brand-400" },
  { label: "国家级", value: national, icon: "medal", accent: "text-brand-600 dark:text-brand-400" },
  { label: "国际级", value: intl, icon: "rocket", accent: "text-aurora-violet dark:text-violet-300" },
  { label: "金奖 / 一等奖", value: gold, icon: "sparkles", accent: "text-amber-600 dark:text-amber-400" },
];

const levels = [
  { label: "国家级", count: national, bar: "from-brand-500 to-brand-600" },
  { label: "国际级", count: intl, bar: "from-aurora-violet to-fuchsia-500" },
  { label: "省级", count: provincial, bar: "from-azure-500 to-azure-600" },
  { label: "其他", count: other, bar: "from-slate-400 to-slate-500" },
].filter((l) => l.count > 0);

const medals = [
  { label: "金奖 · 一等奖", count: gold, bar: "from-amber-300 to-amber-500", icon: "trophy" },
  { label: "银奖 · 二等奖", count: silver, bar: "from-slate-300 to-slate-400", icon: "medal" },
  { label: "铜奖 · 三等奖", count: bronze, bar: "from-amber-600 to-amber-800", icon: "medal" },
];
const medalTotal = gold + silver + bronze || 1;

const yearCounts = grouped
  .filter((g) => typeof g.year === "number")
  .map((g) => ({ year: g.year as number, count: g.items.length }))
  .sort((a, b) => a.year - b.year);
const maxYear = Math.max(...yearCounts.map((y) => y.count), 1);
---

<BaseLayout
  title="我们的成果"
  description="Aurora 战队历年在 RoboMaster 机甲大师赛及各类学科竞赛中斩获的荣誉与奖项。"
>
  <PageHero
    icon="trophy"
    eyebrow="荣誉成果"
    title="我们的成果"
    subtitle="矢志不退，勇者无畏 —— 以 RoboMaster 机甲大师赛为主、各类学科竞赛为辅，Aurora 战队多方面综合发展。"
  >
    {
      total > 0 && (
        <p class="mt-5 text-sm text-slate-500 dark:text-slate-400">
          根据不完全统计，Aurora 战队已累计获得
          <span class="font-display text-base font-bold text-brand-600 dark:text-brand-400">
            {total}
          </span>{" "}
          项奖项。
        </p>
      )
    }
  </PageHero>

  {
    total === 0 ? (
      <Section>
        <div class="card mx-auto max-w-xl p-10 text-center sm:p-12">
          <span class="mx-auto inline-flex size-14 items-center justify-center rounded-2xl bg-brand-600/10 text-brand-600 dark:bg-brand-500/15 dark:text-brand-400">
            <Icon name="trophy" class="size-7" />
          </span>
          <h2 class="mt-5 text-xl font-bold">荣誉墙整理中</h2>
          <p class="mt-3 leading-relaxed text-slate-500 dark:text-slate-400">
            战队的获奖记录正在整理录入，敬请期待。我们将持续在 RoboMaster
            及各类竞赛中突破自我，把每一份荣誉都记录在这里。
          </p>
          <div class="mt-7 flex flex-wrap justify-center gap-3">
            <Button href="/projects" icon="bot" variant="outline">
              先看看我们的机器人
            </Button>
            <Button href="/events" icon="swords" variant="ghost">
              历史赛程
            </Button>
          </div>
        </div>
      </Section>
    ) : (
      <Section>
        <h2 class="mb-8 font-display text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">
          数据概览
        </h2>
        <div class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
          {stats.map((s) => (
            <div class="card relative flex flex-col gap-2 p-5 sm:p-6">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-slate-100 text-slate-500 dark:bg-white/5 dark:text-slate-300">
                <Icon name={s.icon} class="size-5" />
              </span>
              <span class={`font-display text-4xl font-bold tabular-nums ${s.accent}`}>
                {s.value}
              </span>
              <span class="text-sm font-medium text-slate-500 dark:text-slate-400">
                {s.label}
              </span>
            </div>
          ))}
        </div>

        <div class="mt-6 grid gap-5 lg:grid-cols-2">
          <div class="card p-6">
            <h3 class="flex items-center gap-2 font-display text-lg font-semibold text-slate-900 dark:text-white">
              <Icon name="target" class="size-5 text-brand-500" />
              奖项级别分布
            </h3>
            <div class="mt-5 space-y-4">
              {levels.map((l) => (
                <div>
                  <div class="mb-1.5 flex items-baseline justify-between text-sm">
                    <span class="font-medium text-slate-700 dark:text-slate-300">
                      {l.label}
                    </span>
                    <span class="font-display font-semibold tabular-nums text-slate-500 dark:text-slate-400">
                      {l.count}
                      <span class="ml-1 text-xs font-normal text-slate-400">/ {total}</span>
                    </span>
                  </div>
                  <div class="h-2.5 overflow-hidden rounded-full bg-slate-100 dark:bg-white/5">
                    <div
                      class={`h-full rounded-full bg-gradient-to-r ${l.bar}`}
                      style={`width:${Math.max((l.count / total) * 100, 4)}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="card p-6">
            <h3 class="flex items-center gap-2 font-display text-lg font-semibold text-slate-900 dark:text-white">
              <Icon name="medal" class="size-5 text-amber-500" />
              奖牌成色分布
            </h3>
            <div class="mt-5 space-y-4">
              {medals.map((m) => (
                <div>
                  <div class="mb-1.5 flex items-baseline justify-between text-sm">
                    <span class="flex items-center gap-1.5 font-medium text-slate-700 dark:text-slate-300">
                      <Icon name={m.icon} class="size-4 text-slate-400" />
                      {m.label}
                    </span>
                    <span class="font-display font-semibold tabular-nums text-slate-500 dark:text-slate-400">
                      {m.count}
                    </span>
                  </div>
                  <div class="h-2.5 overflow-hidden rounded-full bg-slate-100 dark:bg-white/5">
                    <div
                      class={`h-full rounded-full bg-gradient-to-r ${m.bar}`}
                      style={`width:${Math.max((m.count / medalTotal) * 100, 4)}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {yearCounts.length > 0 && (
          <div class="card mt-5 p-6">
            <h3 class="flex items-center gap-2 font-display text-lg font-semibold text-slate-900 dark:text-white">
              <Icon name="calendar" class="size-5 text-aurora-cyan" />
              各年度获奖数量
            </h3>
            <div class="mt-6 flex h-44 items-end justify-between gap-2 sm:gap-4">
              {yearCounts.map((y) => (
                <div class="flex h-full flex-1 flex-col items-center justify-end gap-2">
                  <span class="font-display text-sm font-bold tabular-nums text-slate-700 dark:text-slate-200">
                    {y.count}
                  </span>
                  <div
                    class="w-full max-w-[3.5rem] rounded-t-lg bg-gradient-to-t from-brand-600 to-brand-400 transition-[height] duration-500 dark:from-brand-700 dark:to-brand-500"
                    style={`height:${Math.max((y.count / maxYear) * 100, 6)}%`}
                    title={`${y.year} 年 · ${y.count} 项`}
                  />
                  <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
                    {String(y.year).slice(2)}'
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}
      </Section>
    )
  }

  {
    total > 0 && (
      <Section class="border-t border-slate-200/70 dark:border-white/10" innerClass="!pt-10">
        <div class="flex items-end justify-between gap-4">
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">
            荣誉<span class="aurora-text">榜</span>
          </h2>
          <p class="hidden text-sm text-slate-500 dark:text-slate-400 sm:block">
            按年度排列 · 共 {grouped.length} 个赛季
          </p>
        </div>

        <div class="mt-10 space-y-14">
          {grouped.map((group) => (
            <div>
              <div class="mb-6 flex items-center gap-4">
                <h3 class="flex items-baseline gap-2 font-display text-xl font-bold text-slate-900 dark:text-white">
                  <span class="text-3xl text-brand-600 dark:text-brand-400 sm:text-4xl">
                    {group.year}
                  </span>
                  <span class="text-base font-medium text-slate-400">
                    {typeof group.year === "number" ? "年" : ""}
                  </span>
                </h3>
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500 dark:bg-white/5 dark:text-slate-400">
                  {group.items.length} 项
                </span>
                <span class="h-px flex-1 bg-gradient-to-r from-slate-200 to-transparent dark:from-white/10" />
              </div>
              <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {group.items.map((award) => (
                  <AwardCard award={award} memberIds={memberIds} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
